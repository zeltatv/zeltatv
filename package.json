{
	"name": "zeltatv",
	"productName": "ZeltaTV",
	"private": true,
	"version": "0.1.4",
	"license": "GPL-3.0-only",
	"type": "module",
	"main": "electron/main.mjs",
	"scripts": {
		"dev": "vite dev",
		"dev:electron": "concurrently \"vite dev\" \"wait-on http://localhost:5173 && node electron/dev-launch.mjs\"",
		"build": "vite build",
		"build:electron": "vite build && electron-builder",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"build": {
		"appId": "com.zeltatv.app",
		"productName": "ZeltaTV",
		"directories": {
			"output": "release"
		},
		"files": [
			"electron/**/*",
			"build/**/*"
		],
		"mac": {
			"category": "public.app-category.entertainment",
			"icon": "static/assets/macos/icon-1024x1024px.icns"
		},
		"win": {
			"target": "nsis",
			"icon": "static/assets/windows/icon-256x256px.ico"
		},
		"linux": {
			"target": "AppImage",
			"icon": "static/assets/linux/"
		}
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.3",
		"@lucide/svelte": "^1.33.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.2.0",
		"bits-ui": "^2.19.0",
		"clsx": "^2.1.1",
		"concurrently": "^10.0.5",
		"electron": "^43.4.1",
		"electron-builder": "^26.15.3",
		"eslint": "^10.8.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"remixicon": "^4.9.1",
		"shadcn-svelte": "^1.5.0",
		"svelte": "^5.56.9",
		"svelte-check": "^4.7.6",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.67.0",
		"vite": "^8.2.2",
		"wait-on": "^9.1.0"
	},
	"dependencies": {
		"hls.js": "^1.7.1"
	}
}
